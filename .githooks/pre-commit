#!/usr/bin/env bash
set -euo pipefail

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

# Everything under agents/ is a live Claude Code or Codex login: not only the
# credential files, but the session transcripts and project history alongside
# them. The directory is git-ignored, so a staged path here means someone
# reached for `git add -f` — match on the path rather than on filenames,
# because the set of files those CLIs write is theirs to change, not ours.
blocked_files="$(printf '%s\n' "${staged_files}" \
  | grep -E '(^|/)(\.env($|\.)|.*\.(pem|key|p12|pfx)|\.?credentials\.json$)|^agents/' \
  | grep -vE '(^|/)\.env\.example$|^agents/\.gitkeep$' || true)"

if [[ -n "${blocked_files}" ]]; then
  echo "Commit blocked: sensitive file names are staged:" >&2
  echo "${blocked_files}" >&2
  exit 1
fi

added_lines="$(git diff --cached --no-ext-diff --unified=0 \
  | grep '^+' \
  | grep -v '^+++' || true)"

if grep -Eq '([s]k-cmdop-[A-Za-z0-9_-]{16,}|[s]k-[A-Za-z0-9_-]{20,}|cmdop_live_[A-Za-z0-9_-]{20,}|BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY)' \
  <<<"${added_lines}"; then
  echo "Commit blocked: a probable API key or private key is staged." >&2
  exit 1
fi
