# Per-machine settings — what differs between your laptop and someone else's.
#
# Everything that describes a CONCERN rather than a machine lives beside this
# file, one file per owner:
#
#   env/cmdop.env    the relay and agent
#   env/demo.env     the Vite site
#   env/agents.env   Claude Code and Codex
#
# `make setup` creates all four from their examples.

# ── Credentials ──────────────────────────────────────────────────────────────
# The initial browser-console password. Compose mounts it as a secret file, so
# it never becomes an environment variable inside the container.
CMDOP_ADMIN_PASSWORD=change-this-local-password

# The Cmdop platform key: inference, and — in public relay mode — registering
# this relay's address. It sits here rather than in env/cmdop.env because
# Compose renames it on the way in (you write CMDOP_API_KEY, the binary reads
# CMDOP_ROUTER_API_KEY), and only a ${...} substitution can do that.
CMDOP_API_KEY=

# ── Host wiring ──────────────────────────────────────────────────────────────
# Loopback by default, so the site and console are not exposed to your LAN.
# Set 0.0.0.0 deliberately when remote access is wanted.
HOST_BIND_ADDRESS=127.0.0.1
DEMO_HOST_PORT=8080
CMDOP_HOST_PORT=63141

# Files the container writes into bind mounts should belong to you, not root.
# On Linux: id -u / id -g.
HOST_UID=1000
HOST_GID=1000

# ── What goes into the image (build-time) ────────────────────────────────────
# Each is a build argument. 0 makes a smaller image; the container runs fine
# without the omitted piece.
CMDOP_BROWSER=1
CMDOP_CLAUDE_CODE=1
CMDOP_CODEX=1
