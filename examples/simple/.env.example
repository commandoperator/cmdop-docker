# Copy to .env and fill in.

# The relay this machine should join.
CMDOP_SERVER_URL=https://your-team.cmdop.dev

# The fleet's join key. Get it on the relay host: `cmdop server join-key`.
#
# A durable, multi-use secret — treat it like one. For anything beyond a local
# try, prefer CMDOP_JOIN_KEY_FILE pointing at a mounted secret instead: an
# environment variable is visible to `docker inspect`.
CMDOP_JOIN_KEY=cmdop_enroll_xxxxxxxx
