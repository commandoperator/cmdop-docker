# Copy to `.env` and edit. Grouped by what each setting belongs to.

# ── Cmdop ────────────────────────────────────────────────────────────────────
# The platform key: inference, and — in public relay mode — registering this
# relay's address. Leave empty to stay on the LAN.
CMDOP_API_KEY=

# The initial browser-console password. Compose mounts it as a secret file, so
# it never becomes an environment variable inside the container.
CMDOP_ADMIN_PASSWORD=change-this-local-password

# "auto" picks public when a subdomain is set, otherwise LAN.
CMDOP_RELAY_MODE=auto
CMDOP_PUBLIC_SUBDOMAIN=

# The name this machine shows in the fleet.
CMDOP_MACHINE_NAME=cmdop-live-demo

# Approval prompts for agent actions. "bypass" only in a disposable environment.
CMDOP_PERMISSIONS_MODE=default

# ── Demo site ────────────────────────────────────────────────────────────────
# The workspace the agent edits, and who its commits are attributed to.
CMDOP_AGENT_CWD=/workspace/demo
CMDOP_GIT_AUTHOR_NAME=Cmdop Agent
CMDOP_GIT_AUTHOR_EMAIL=agent@cmdop.local

# Bind-mount file watching is unreliable on some hosts; polling is safe here.
VITE_USE_POLLING=true
VITE_POLL_INTERVAL_MS=300
# Only when the HMR websocket must reach the browser on a different port.
VITE_HMR_CLIENT_PORT=

# ── Coding CLIs ──────────────────────────────────────────────────────────────
# Codex sandboxes commands through bubblewrap, which a container often cannot
# create. "auto" probes it at startup. See docs/coding-agents.md.
CMDOP_CODEX_SANDBOX=auto

# ── This host ────────────────────────────────────────────────────────────────
# Loopback by default, so the site and console are not exposed to your LAN.
HOST_BIND_ADDRESS=127.0.0.1
DEMO_HOST_PORT=8080
CMDOP_HOST_PORT=63141

# Files written into bind mounts should belong to you, not root (Linux: id -u).
HOST_UID=1000
HOST_GID=1000

# ── What goes into the image ─────────────────────────────────────────────────
# Build arguments. 0 makes a smaller image; the container runs without the part.
CMDOP_BROWSER=1
CMDOP_CLAUDE_CODE=1
CMDOP_CODEX=1
