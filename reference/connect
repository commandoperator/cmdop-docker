#!/bin/sh
set -eu
cd "$(dirname "$0")"
if [ -n "${CMDOP_REPORT_IMAGE:-}" ]; then
  docker compose pull report-app
else
  docker compose build report-app
fi
docker compose run --rm --no-deps --pull never --entrypoint python report-app /opt/report/connect.py "$@"
docker compose up -d --no-build --no-deps --pull never report-app
docker compose exec -T report-app python /opt/report/wait_online.py
machine_id=$(docker compose exec -T report-app cmdop key)
printf 'SDK machine ID: %s\n' "$machine_id"
