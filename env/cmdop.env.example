# ── Cmdop ────────────────────────────────────────────────────────────────────
# The relay and agent. Nothing here belongs to the demo site, the coding CLIs,
# or the image build — those have their own files beside this one.
#
# Copy to `env/cmdop.env` (gitignored) and edit there.

# "auto" picks public when CMDOP_PUBLIC_SUBDOMAIN is set, otherwise LAN.
CMDOP_RELAY_MODE=auto
CMDOP_PUBLIC_SUBDOMAIN=

# The name this machine carries in the fleet. Without it the name falls back to
# the container's hostname, which Docker regenerates on every recreate.
CMDOP_MACHINE_NAME=cmdop-live-demo

# Approval prompts for agent actions. "bypass" only in a disposable environment.
CMDOP_PERMISSIONS_MODE=default

# The working directory inbound chats operate in.
CMDOP_AGENT_CWD=/workspace/demo

# Two Cmdop settings are NOT here, both because Compose has to transform them:
#   CMDOP_API_KEY        → renamed to CMDOP_ROUTER_API_KEY on the way in
#   CMDOP_ADMIN_PASSWORD → mounted as a Compose secret, never as an env var
# Both live in `.env`.
