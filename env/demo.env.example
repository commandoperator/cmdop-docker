# ── The demo site ────────────────────────────────────────────────────────────
# This stand ships a small Vite project as a writable canvas for the agent.
# A plain Cmdop container has none of this.
#
# Copy to `env/demo.env`.

# Bind-mount file watching is unreliable on some hosts; polling is the safe
# default here.
VITE_USE_POLLING=true
VITE_POLL_INTERVAL_MS=300

# Only when the HMR websocket must reach the browser on a different public port
# than the site itself.
VITE_HMR_CLIENT_PORT=

# Identity for the local commits the agent makes in the isolated demo repo.
CMDOP_GIT_AUTHOR_NAME=Cmdop Agent
CMDOP_GIT_AUTHOR_EMAIL=agent@cmdop.local
